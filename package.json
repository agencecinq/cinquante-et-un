{
  "name": "@cinq/cinquante-et-un",
  "version": "0.3.1",
  "description": "Opinionated Shopify theme starter for Cinq (Vite, Tailwind, piecesjs, @agencecinq)",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "keywords": [
    "shopify",
    "theme",
    "vite",
    "tailwind",
    "cinq"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agencecinq/cinquante-et-un.git"
  },
  "scripts": {
    "dev": "run-p shopify:dev vite:watch",
    "build": "run-s vite:build",
    "shopify:dev": "shopify theme dev --environment development",
    "vite:watch": "cross-env NODE_ENV=development vite",
    "vite:build": "cross-env NODE_ENV=production vite build"
  },
  "devDependencies": {
    "@by-association-only/vite-plugin-shopify-clean": "^2.2.0",
    "@shopify/prettier-plugin-liquid": "^1.11.2",
    "@tailwindcss/vite": "^4.3.3",
    "cross-env": "^10.1.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vite": "^8.3.3",
    "vite-plugin-shopify": "^5.0.0",
    "vite-svg-sprite-wrapper": "^1.5.0"
  },
  "dependencies": {
    "@agencecinq/accordion": "^4.2.1",
    "@agencecinq/calendar": "^4.3.2",
    "@agencecinq/combobox": "^2.1.2",
    "@agencecinq/disclosure-button": "^3.1.2",
    "@agencecinq/drawer": "^9.1.3",
    "@agencecinq/drilldown": "^1.4.2",
    "@agencecinq/modal": "^6.1.3",
    "@agencecinq/spinbutton": "^4.1.2",
    "@agencecinq/store": "^1.1.1",
    "@agencecinq/switch": "^4.1.2",
    "@agencecinq/tabs": "^12.0.2",
    "@agencecinq/toast": "^1.1.2",
    "@agencecinq/utils": "^11.0.2",
    "@agencecinq/windowsplitter": "^3.1.2",
    "invokers-polyfill": "^1.0.4",
    "piecesjs": "^0.5.7",
    "tailwindcss": "^4.3.3"
  }
}

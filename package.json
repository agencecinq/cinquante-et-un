{
  "name": "@cinq/cinquante-et-un",
  "version": "0.3.1",
  "description": "Opinionated Shopify theme starter for Cinq (Vite, Tailwind, piecesjs, @agencecinq)",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "keywords": [
    "shopify",
    "theme",
    "vite",
    "tailwind",
    "cinq"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agencecinq/cinquante-et-un.git"
  },
  "scripts": {
    "dev": "run-p shopify:dev vite:watch",
    "build": "run-s vite:build",
    "shopify:dev": "shopify theme dev --environment development",
    "vite:watch": "cross-env NODE_ENV=development vite",
    "vite:build": "cross-env NODE_ENV=production vite build"
  },
  "devDependencies": {
    "@by-association-only/vite-plugin-shopify-clean": "^2.2.0",
    "@shopify/prettier-plugin-liquid": "^1.11.0",
    "@tailwindcss/vite": "^4.3.3",
    "cross-env": "^10.1.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vite": "^8.2.2",
    "vite-plugin-shopify": "^5.0.0",
    "vite-svg-sprite-wrapper": "^1.5.0"
  },
  "dependencies": {
    "@agencecinq/accordion": "^3.0.0",
    "@agencecinq/calendar": "^3.0.0",
    "@agencecinq/combobox": "^1.0.4",
    "@agencecinq/disclosure-button": "^3.0.1",
    "@agencecinq/drawer": "^7.0.1",
    "@agencecinq/modal": "^4.0.1",
    "@agencecinq/spinbutton": "^4.0.0",
    "@agencecinq/switch": "^3.0.1",
    "@agencecinq/tabs": "^11.0.0",
    "@agencecinq/toast": "^1.0.0",
    "@agencecinq/utils": "^7.4.0",
    "@agencecinq/windowsplitter": "^2.0.1",
    "piecesjs": "^0.5.5",
    "tailwindcss": "^4.3.3"
  }
}

[
  {
    "name": "theme_info",
    "theme_name": "Cinquante-et-un",
    "theme_version": "0.0.0",
    "theme_author": "Cinq",
    "theme_support_url": "https://www.agencecinq.com/",
    "theme_documentation_url": "https://www.agencecinq.com/"
  },
  {
    "name": "t:settings_schema.favicon.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings_schema.favicon.settings.favicon.label",
        "info": "t:settings_schema.favicon.settings.favicon.info"
      }
    ]
  },
  {
    "name": "t:settings_schema.colors.name",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:settings_schema.colors.settings.background.label",
            "default": "#FFFFFF"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "t:settings_schema.colors.settings.background_gradient.label",
            "info": "t:settings_schema.colors.settings.background_gradient.info"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:settings_schema.colors.settings.text.label",
            "default": "#2A343A"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:settings_schema.colors.settings.button_background.label",
            "default": "#2A343A"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:settings_schema.colors.settings.button_label.label",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "t:settings_schema.colors.settings.secondary_button_label.label",
            "default": "#2A343A"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "secondary_button_label",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label"
        }
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      },
      {
        "type": "font_picker",
        "id": "type_secondary_font",
        "default": "work_sans_n4",
        "label": "t:general.secondary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:settings_schema.cart.name",
    "settings": [
      {
        "type": "inline_richtext",
        "id": "tax_included_text",
        "label": "t:settings_schema.cart.settings.tax_included_text.label",
        "default": "t:settings_schema.cart.settings.tax_included_text.default",
        "info": "t:settings_schema.cart.settings.tax_included_text.info"
      },
      {
        "type": "header",
        "content": "t:settings_schema.cart.settings.free_delivery.header.content"
      },
      {
        "type": "checkbox",
        "id": "free_delivery_enable",
        "label": "t:settings_schema.cart.settings.free_delivery_enable.label",
        "info": "t:settings_schema.cart.settings.free_delivery_enable.info",
        "default": true
      },
      {
        "id": "free_delivery_amount",
        "label": "t:settings_schema.cart.settings.free_delivery_amount.label",
        "default": 100,
        "type": "number",
        "info": "t:settings_schema.cart.settings.free_delivery_amount.info"
      },
      {
        "id": "free_delivery_label",
        "label": "t:settings_schema.cart.settings.free_delivery_label.label",
        "type": "inline_richtext",
        "default": "t:settings_schema.cart.settings.free_delivery_label.default",
        "info": "t:settings_schema.cart.settings.free_delivery_label.info"
      },
      {
        "id": "free_delivery_text",
        "label": "t:settings_schema.cart.settings.free_delivery_text.label",
        "type": "inline_richtext",
        "default": "t:settings_schema.cart.settings.free_delivery_text.default",
        "info": "t:settings_schema.cart.settings.free_delivery_text.info"
      },
      {
        "type": "header",
        "content": "t:settings_schema.cart.settings.cart_reassurance.header.content"
      },
      {
        "type": "checkbox",
        "id": "cart_reassurance_enable",
        "label": "t:settings_schema.cart.settings.cart_reassurance.cart_reassurance_enable.label",
        "default": true
      },
      {
        "type": "inline_richtext",
        "id": "cart_reassurance_text_1",
        "label": "t:settings_schema.cart.settings.cart_reassurance.cart_reassurance_text_1.label",
        "default": "t:settings_schema.cart.settings.cart_reassurance.cart_reassurance_text_1.default",
        "info": "t:settings_schema.cart.settings.cart_reassurance.cart_reassurance_text_1.info"
      },
      {
        "type": "inline_richtext",
        "id": "cart_reassurance_text_2",
        "label": "t:settings_schema.cart.settings.cart_reassurance.cart_reassurance_text_2.label",
        "default": "t:settings_schema.cart.settings.cart_reassurance.cart_reassurance_text_2.default",
        "info": "t:settings_schema.cart.settings.cart_reassurance.cart_reassurance_text_2.info"
      },
      {
        "type": "inline_richtext",
        "id": "cart_reassurance_text_3",
        "label": "t:settings_schema.cart.settings.cart_reassurance.cart_reassurance_text_3.label",
        "default": "t:settings_schema.cart.settings.cart_reassurance.cart_reassurance_text_3.default",
        "info": "t:settings_schema.cart.settings.cart_reassurance.cart_reassurance_text_3.info"
      },
      {
        "type": "product_list",
        "id": "cart_recommendations",
        "label": "t:settings_schema.cart.settings.cart_recommendations.label",
        "info": "t:settings_schema.cart.settings.cart_recommendations.info",
        "limit": 3
      },
      {
        "type": "header",
        "content": "t:settings_schema.cart.settings.cart_gift_wrap.header.content"
      },
      {
        "type": "product",
        "id": "cart_gift_wrap_product",
        "label": "t:settings_schema.cart.settings.cart_gift_wrap_product.label",
        "info": "t:settings_schema.cart.settings.cart_gift_wrap_product.info"
      }
    ]
  },

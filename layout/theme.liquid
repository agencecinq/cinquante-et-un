<!doctype html>
<html
  class="is-on-top"
  lang="{{ request.locale.iso_code }}"
  style="--announcement-bar-height: 0px; --header-height: 4.5rem;"
>
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Social, title, etc. %}
    {%- render 'meta-tags' -%}
    {%- render 'vite-tag' with 'stylesheets/styles.css', preload_stylesheet: true -%}
    {%- render 'vite-tag' with 'scripts/app.ts' -%}
    {{ content_for_header }}
  </head>

  <body class="text-base template-{{ template | replace: '.', '-' }}">
    <a
      href="#MainContent"
      class="fixed -top-96 left-4 z-50 block border border-black bg-white px-3 py-2 text-sm text-black focus:top-4 focus-visible:top-4"
    >
      {{- 'accessibility.skip_to_content' | t -}}
    </a>

    {% sections 'header-group' %}

    <main
      id="MainContent"
      tabindex="-1"
      {% unless template.name == 'index' %}
        style="padding-top: var(--header-height);"
      {% endunless %}
    >
      {{ content_for_layout }}
    </main>

    {%- sections 'footer-group' -%}
    {%- section 'cart-drawer' -%}

    <div class="hidden">
      {%
        # ⚠️ inline_asset_content doesn't work with file larger than 15kb
        # If so copy the content of sprite.svg into a snippet and render it instead.
        # See: https://shopify.dev/docs/api/liquid/filters/asset-filters#inline_asset_content
      %}
      {{- 'sprite.svg' | inline_asset_content -}}
    </div>

    <c-toast
      role="alert"
      aria-live="assertive"
      aria-atomic="true"
      class="after:ease-none fixed top-0 right-0 z-50 my-4 ml-4 flex w-[calc(100%-1rem)] max-w-md translate-x-full items-center gap-4 overflow-hidden border border-black bg-white px-4 py-3 transition-transform duration-200 after:absolute after:inset-x-0 after:bottom-0 after:h-px after:w-full after:origin-left after:scale-x-(--counter) after:bg-black open:translate-x-0"
      style="--counter: 0%;"
      data-counter="0"
      tabindex="-1"
    >
      <div data-dom="content"></div>
      <button
        class="ml-auto flex size-8 shrink-0 items-center justify-center border border-black"
        aria-label="close"
        data-dom="button"
      >
        {%- render 'use.html', icon: 'times', classes: 'size-4' -%}
      </button>
    </c-toast>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
      cart_add_url: '{{ routes.cart_add_url }}',
      cart_change_url: '{{ routes.cart_change_url }}',
      cart_update_url: '{{ routes.cart_update_url }}',
      cart_url: '{{ routes.cart_url }}',
      predictive_search_url: '{{ routes.predictive_search_url }}',
      };
      window.cart = {{ cart | json }};

      var Shopify = Shopify || {};
      Shopify.money_format = '{{ shop.money_format }}';
    </script>
  </body>
</html>

{
  "sections": {
    "hero": {
      "type": "section-hero",
      "blocks": {
        "hero_title": {
          "type": "title",
          "settings": {
            "title": "Cinquante-et-un",
            "tag": "h1",
            "font_size": "text-xl font-semibold lg:text-3xl"
          },
          "blocks": {}
        },
        "hero_text": {
          "type": "text",
          "settings": {
            "text": "<p>Starter Shopify wireframe — Vite, Tailwind, piecesjs et composants @agencecinq.</p>",
            "tag": "div",
            "font_size": "text-base"
          },
          "blocks": {}
        },
        "hero_link": {
          "type": "link",
          "settings": {
            "link_url": "shopify://collections/all",
            "link_title": "Voir la boutique",
            "link_aria_label": "Voir la boutique",
            "link_target": "_self"
          },
          "blocks": {}
        }
      },
      "block_order": ["hero_title", "hero_text", "hero_link"],
      "settings": {
        "full_bleed": false,
        "show_media_overlay": false,
        "space_between": "space-y-6",
        "alignment_horizontal": "lg:col-start-1 lg:text-start",
        "alignment_vertical": "items-end",
        "padding_top": 40,
        "padding_bottom": 40
      }
    },
    "intro": {
      "type": "section-richtext",
      "blocks": {
        "intro_title": {
          "type": "title",
          "settings": {
            "title": "Point de départ",
            "tag": "h2",
            "font_size": "text-base font-semibold"
          },
          "blocks": {}
        },
        "intro_text": {
          "type": "text",
          "settings": {
            "text": "<p>Ce thème est volontairement minimal. Remplacez les textes, branchez vos menus, puis construisez les sections projet par-dessus ce socle.</p>",
            "tag": "div",
            "font_size": "text-base"
          },
          "blocks": {}
        }
      },
      "block_order": ["intro_title", "intro_text"],
      "settings": {
        "text_alignment": "text-start",
        "space_between": "space-y-4",
        "columns": "lg:col-start-1 lg:col-span-8",
        "padding_top": 64,
        "padding_bottom": 32
      }
    },
    "stack": {
      "type": "section-richtext",
      "blocks": {
        "stack_title": {
          "type": "title",
          "settings": {
            "title": "Stack inclus",
            "tag": "h2",
            "font_size": "text-base font-semibold"
          },
          "blocks": {}
        },
        "stack_text": {
          "type": "text",
          "settings": {
            "text": "<ul><li>Vite 8 + Tailwind 4</li><li>Cart store Ajax (sections bundlées)</li><li>Web Components @agencecinq</li><li>Header, footer, panier drawer, product/collection de base</li></ul>",
            "tag": "div",
            "font_size": "text-base"
          },
          "blocks": {}
        },
        "stack_link": {
          "type": "link",
          "settings": {
            "link_url": "shopify://pages/contact",
            "link_title": "Page contact",
            "link_aria_label": "Page contact",
            "link_target": "_self"
          },
          "blocks": {}
        }
      },
      "block_order": ["stack_title", "stack_text", "stack_link"],
      "settings": {
        "text_alignment": "text-start",
        "space_between": "space-y-4",
        "columns": "lg:col-start-1 lg:col-span-8",
        "padding_top": 32,
        "padding_bottom": 64
      }
    },
    "featured": {
      "type": "featured-collection",
      "settings": {
        "title": "Nos produits",
        "products_to_show": 4,
        "columns": "4",
        "show_quick_add": true,
        "show_view_all": true,
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "faq": {
      "type": "section-accordion-group",
      "blocks": {
        "faq_1": {
          "type": "accordion",
          "settings": {
            "category": "Starter",
            "title": "Comment démarrer ?",
            "content": "<p>Configurez shopify.theme.toml, lancez pnpm install puis pnpm dev.</p>"
          }
        },
        "faq_2": {
          "type": "accordion",
          "settings": {
            "category": "Starter",
            "title": "Où personnaliser le design ?",
            "content": "<p>Tokens dans src/stylesheets/theme.css, composants Liquid dans sections/ et snippets/.</p>"
          }
        },
        "faq_3": {
          "type": "accordion",
          "settings": {
            "category": "Starter",
            "title": "Le style wireframe est volontaire ?",
            "content": "<p>Oui. Le starter reste neutre pour éviter de reporter une identité de marque d’un projet précédent.</p>"
          }
        }
      },
      "block_order": ["faq_1", "faq_2", "faq_3"],
      "settings": {
        "title": "FAQ",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "cta": {
      "type": "section-richtext",
      "blocks": {
        "cta_title": {
          "type": "title",
          "settings": {
            "title": "Prêt à itérer",
            "tag": "h2",
            "font_size": "text-base font-semibold"
          },
          "blocks": {}
        },
        "cta_text": {
          "type": "text",
          "settings": {
            "text": "<p>Ajoutez vos sections métier, vos tokens et votre contenu. Ce squelette est là pour accélérer le premier commit.</p>",
            "tag": "div",
            "font_size": "text-base"
          },
          "blocks": {}
        },
        "cta_link": {
          "type": "link",
          "settings": {
            "link_url": "shopify://collections/all",
            "link_title": "Explorer les produits",
            "link_aria_label": "Explorer les produits",
            "link_target": "_self"
          },
          "blocks": {}
        }
      },
      "block_order": ["cta_title", "cta_text", "cta_link"],
      "settings": {
        "text_alignment": "text-start",
        "space_between": "space-y-4",
        "columns": "lg:col-start-1 lg:col-span-6",
        "padding_top": 64,
        "padding_bottom": 80
      }
    }
  },
  "order": ["hero", "intro", "featured", "stack", "faq", "cta"]
}

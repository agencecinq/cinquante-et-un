        "values_text": {
          "type": "text",
          "settings": {
            "text": "<ul><li>Clarté — un wireframe lisible avant le branding</li><li>Socle — Vite, Tailwind, piecesjs, @agencecinq</li><li>Éditorial — sections réutilisables, pas de one-shots</li></ul>",
            "tag": "div",
            "font_size": "text-base"
          },
          "blocks": {}
        }
      },
      "block_order": ["values_subtitle", "values_title", "values_text"],
      "settings": {
        "text_alignment": "text-center",
        "space_between": "space-y-4",
        "columns": "lg:col-start-3 lg:col-span-8",
        "padding_top": 48,
        "padding_bottom": 48,
        "compensate_header": false,
        "color_scheme": "background-1"
      }
    },
    "faq": {
      "type": "section-accordion-group",
      "blocks": {
        "faq_1": {
          "type": "accordion",
          "settings": {
            "title": "À quoi sert ce template About ?",
            "content": "<p>Il montre en une page les sections éditoriales du starter (hero, rich text, accordion, featured collection, form). Assignez-le à une page Shopify « À propos ».</p>"
          }
        },
        "faq_2": {
          "type": "accordion",
          "settings": {
            "title": "Puis-je retirer des sections ?",
            "content": "<p>Oui. Dans l’éditeur de thème, masquez ou supprimez les sections inutiles, ou dupliquez celles qui marchent pour votre contenu.</p>"
          }
        },
        "faq_3": {
          "type": "accordion",
          "settings": {
            "title": "Où brancher le contenu CMS ?",
            "content": "<p>La section Page affiche le titre/corps de la page Shopify. Les autres sections sont pilotées par leurs réglages et blocs.</p>"
          }
        }
      },
      "block_order": ["faq_1", "faq_2", "faq_3"],
      "settings": {
        "subtitle": "FAQ",
        "title": "Questions fréquentes",
        "link_title": "",
        "link_url": "",
        "link_target": "_self",
        "padding_top": 48,
        "padding_bottom": 48,
        "color_scheme": "background-1"
      }
    },

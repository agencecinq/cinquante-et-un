{% doc %}
  Use

 This snippet is used to render an SVG icon.

  @param {string} [id] - The icon ID. Optional. Optional.
  @param {string} [classes] - Additional classes to apply to the icon. Optional. Optional.
  @param {string} icon - The icon name. Required.

  @example {% render 'use.html', icon: 'arrow-right', classes: 'text-primary', id: 'my-icon' %}
{% enddoc %}
<svg
  class="fill-current {{ icon }}{% if classes != blank %} {{ classes }}{% endif %}"
  {% if id %}
    id="{{ id }}"
  {% endif %}
>
  <use xlink:href="#icon-{{ icon }}" href="#icon-{{ icon }}"></use>
</svg>

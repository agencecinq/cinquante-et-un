{% doc %}
  Predictive search product row (inside li[role=option]).

  @param {object} product - Product from predictive_search.resources.products.
  @param {string} terms - Search terms (`predictive_search.terms`).
{% enddoc %}

<a
  href="{{ product.url }}"
  class="flex items-center gap-3 px-3 py-2.5 text-sm hover:bg-gray-50"
  tabindex="-1"
>
  <span class="size-10 shrink-0 overflow-hidden border border-black bg-gray-100">
    {%- if product.featured_image != blank -%}
      {{-
        product.featured_image
        | image_url: width: 96
        | image_tag:
          widths: '48, 96',
          sizes: '40px',
          class: 'size-full object-cover object-center',
          loading: 'lazy',
          alt: ''
      -}}
    {%- else -%}
      {{- 'product-1' | placeholder_svg_tag: 'size-full object-cover opacity-40' -}}
    {%- endif -%}
  </span>
  <span class="min-w-0 flex-1 space-y-0.5">
    <span class="line-clamp-1 block [&_mark]:bg-transparent [&_mark]:font-semibold [&_strong]:font-semibold">
      {{- product.title | highlight: terms -}}
    </span>
    <span class="block text-xs opacity-60">
      {{- product.price | money -}}
    </span>
  </span>
</a>

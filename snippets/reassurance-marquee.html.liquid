{% doc %}
  A simple marquee to display reassurance messages like free shipping, fast delivery, etc.

  @param {object} items - An array of reassurance messages to display in the marquee.

  @example {% include 'reassurance-marquee', items: ['Free shipping on orders over $50', 'Fast delivery within 3-5 business days'] %}
{% enddoc %}

{%- if items.size > 0 -%}
  <div class="block overflow-hidden text-sm">
    <style>
      @keyframes marquee {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-50%);
        }
      }
      .animate-marquee {
        animation: marquee 20s linear infinite;
      }
    </style>
    <ul
      style="animation-duration: {{ items.size | times: 8 | at_least: 20 }}s;"
      class="animate-marquee pointer-events-none relative flex w-max flex-nowrap items-center will-change-transform"
    >
      {%- for i in (0..1) -%}
        {%- for item in items -%}
          <li class="shrink-0 pr-10">{{- item -}}</li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

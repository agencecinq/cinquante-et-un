{% doc %}
  Renders a localization button.

  @example
  {% render 'localization-button.html' %}
{% enddoc %}

<cinq-drawer-button class="block">
  <button
    type="button"
    aria-controls="locale-currency-drawer"
    aria-expanded="false"
    class="flex items-center justify-center gap-2 border border-gray-700 px-5 py-2"
  >
    {%- if localization.country and localization.country.iso_code -%}
      <span class="flex items-center gap-2">
        {% # theme-check-disable RemoteAsset %}
        <img
          src="https://flagcdn.com/{{ localization.country.iso_code | downcase }}.svg"
          width="16"
          height="16"
          alt="{{ localization.country.name }}"
          loading="lazy"
          class="size-4 overflow-hidden object-cover object-center"
        >
        <span class="text-xs font-medium">
          {{- localization.country.name -}}
          &nbsp;&lpar;{{ localization.country.currency.symbol }}&rpar;</span
        >
      </span>
    {%- else -%}
      <span class="text-xs font-medium">{{- request.locale.iso_code -}}</span>
    {%- endif -%}

    {{- '&verbar;' -}}

    <span class="text-xs font-medium">
      {{- localization.language.endonym_name -}}
    </span>

    {%- render 'use.html', icon: 'chevron-right', classes: 'size-3' -%}
  </button>
</cinq-drawer-button>

{% doc %}
  Renders the product siblings.

  @param {object} block - The block object.
  @param {object} id - The product id.
  @param {object} siblings - The siblings array.

  @example {% render 'product-siblings.html', block: block, product: product %}
{% enddoc %}

{%- if siblings.size > 0 -%}
  <div class="flex items-end" {{ block.shopify_attributes }}>
    {%- for sibling in siblings -%}
      <a
        href="{{ sibling.product.value.url }}"
        class="flex justify-center border-b-current p-4 {% if sibling.tag %}relative mt-2.5 {% endif %}{% if sibling.product.value.id == id %}text-black{% else %}text-gray-200{% endif %} flex-1 items-center gap-1.5 border-b-2"
      >
        {% if sibling.tag %}
          <span class="absolute top-0 right-0 -mt-2.5 mr-6 bg-black p-1.5 text-xs font-medium text-white">
            {{- sibling.tag -}}
          </span>
        {% endif %}
        {% if sibling.image %}
          {{- sibling.image | image_url: width: 40 | image_tag: class: 'size-5' -}}
        {% endif %}
        <span class="text-base font-medium">{{- sibling.title -}}</span>
      </a>
    {%- endfor -%}
  </div>
{%- endif -%}

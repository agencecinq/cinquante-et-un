{% doc %}
  Cart drawer header snippet.

  @param {string} id - Unique section ID.

  @example {% render 'cart-header.html', id: section.id %}
{% enddoc %}

{%- capture cart_title -%}
  {{- 'cart.drawer.header.title' | t -}}
  &nbsp;&lpar;{{- cart.item_count -}}&rpar;
{%- endcapture -%}

<header
  id="CartDrawerHeader-{{ id }}"
  class="js-cart-header flex items-center justify-between gap-4 border-b border-black px-5 py-6"
>
  <p class="text-sm font-medium">{{- cart_title -}}</p>
  <cinq-drawer-button class="ms-auto flex items-center justify-center">
    <button
      data-dom="button"
      aria-controls="cart-drawer"
      aria-expanded="false"
      type="button"
      aria-label="{{ 'cart.drawer.close.label' | t }}"
      class="flex size-6 items-center justify-center"
    >
      {%- render 'use.html', icon: 'times', classes: 'size-3.5' -%}
    </button>
  </cinq-drawer-button>
</header>

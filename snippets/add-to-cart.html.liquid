{% doc %}
  @param {object} product - The product object to add to the cart. (Optional)
  @param {number} [quantity] - The quantity of the product to add to the cart. Default is 1. Optional.
  @param {string} [drawer] - Id of the drawer dialog to open once the item is in the cart. Default is 'cart-drawer'. An empty string opens none (the cart drawer's own recommendations). Optional.
  @param {string} [button] - The HTML content of the button. The button needs to have a data-dom="button" attribute to be used by the JavaScript. Default is a button with an icon. Optional.
  @param {string} [classes] - The classes to add to the button. Default is 'w-full'. Optional.

  @example {% render 'add-to-cart.html', product: product, quantity: 1, button: '<button data-dom="button">My button</button>' %}
{% enddoc %}

{% liquid
  assign variant = product.selected_or_first_available_variant
  assign id = variant.id
  assign quantity = quantity | default: 1
  if drawer == null
    assign drawer = 'cart-drawer'
  endif
  assign classes = classes | default: 'block'

  assign check_against_inventory = true

  if variant.inventory_management != 'shopify' or variant.inventory_policy == 'continue'
    assign check_against_inventory = false
  endif

  if variant.quantity_rule.min > variant.inventory_quantity and check_against_inventory
    assign quantity_rule_soldout = true
  endif
%}

{%- unless button -%}
  {%- liquid
    assign atc_title = 'snippets.add-to-cart.add_to_cart' | t
    assign atc_product_title = variant.product.title | default: product.title
    assign atc_label = 'sections.product.add_to_cart' | t | append: ' ' | append: atc_product_title
    assign atc_disabled = false
    if variant.available == false or quantity_rule_soldout or variant == null
      assign atc_disabled = true
    endif
  -%}
  {% capture atc_attributes -%}
    data-dom="button" aria-label="{{ atc_label | escape }}"{% if atc_disabled %} disabled{% endif %}
  {%- endcapture %}
  {% capture button %}
    {%- render 'button.html',
      title: atc_title,
      type: 'submit',
      classes: 'w-full',
      variant: 'primary',
      attributes: atc_attributes
    -%}
  {%- endcapture -%}
{%- endunless -%}

{% unless id == false or id == null or id == blank or variant.available == false -%}
  <c-add-to-cart-button
    class="{{ classes }} aria-busy:cursor-wait aria-busy:opacity-50"
    data-drawer="{{ drawer }}"
    in-stock
  >
    <form action="{{ routes.cart_add_url }}" method="post" data-dom="form">
      <input type="hidden" name="id" value="{{ id }}">
      <input type="hidden" name="quantity" value="{{ quantity }}">
      {{- button -}}
    </form>
  </c-add-to-cart-button>
{%- endunless -%}

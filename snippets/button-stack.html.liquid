{% doc %}
  Pill-shaped link with three stacked thumbnails and a label.

  @param {string} url - Link URL.
  @param {string} title - Visible label text.
  @param {string} [target] - Link target (`_blank` for a new tab).
  @param {image} [image_1] - First thumbnail.
  @param {image} [image_2] - Second thumbnail.
  @param {image} [image_3] - Third thumbnail.
  @param {string} [classes] - Classes for the `<a>` element (optional).
  @param {object} [block] - Section block for `shopify_attributes` (optional).

  @example
  {% render 'button-stack.html',
 url: block.settings.url,
 target: block.settings.target,
 title: block.settings.title,
 image_1: block.settings.image_1,
 image_2: block.settings.image_2,
 image_3: block.settings.image_3,
 block: block
 %}
{% enddoc %}

{%- liquid
  assign classes = classes | default: 'border-gray-200 inline-flex items-center gap-4 border py-1 ps-1 pe-9'
-%}

<a
  href="{{ url }}"
  {% if target == '_blank' %}
    target="_blank" rel="noopener noreferrer"
  {% endif %}
  class="{{ classes }}"
  {% if block %}
    {{- block.shopify_attributes -}}
  {% endif %}
>
  <div class="inline-grid grid-cols-[28px_28px_56px] grid-rows-1 items-center overflow-visible">
    {%- for i in (1..3) -%}
      <div class="w-14">
        {% liquid
          case i
            when 1
              assign image = image_1
            when 2
              assign image = image_2
            when 3
              assign image = image_3
          endcase

          if image != blank
            echo image | image_url: width: 112 | image_tag: class: 'size-14 border-2 border-white object-cover object-center'
          else
            echo 'product-' | append: i | placeholder_svg_tag: 'bg-gray-200 size-14 border-2 border-white object-cover object-center'
          endif
        %}
      </div>
    {%- endfor -%}
  </div>
  <span class="text-xs font-medium">
    {{- title -}}
  </span>
</a>

{% doc %}
  Renders linked product variations (metaobject list of product groups).

  @param {object} block - The block object.
  @param {number} id - The current product id.
  @param {object} variations - The variations list (each item has `label` and `products`).

  @example {% render 'product-variations.html', block: block, id: product.id, variations: variations %}
{% enddoc %}

<div class="space-y-6" {{ block.shopify_attributes }}>
  {%- if block.settings.layout == 'select' -%}
    {%- for variation in variations -%}
      {%- assign variation_id = variation.label | handleize -%}
      <div class="flex justify-between gap-2 lg:gap-4">
        <label class="flex items-center gap-1.5" for="variation-{{ variation_id }}">
          <span class="text-sm font-medium">
            {{- variation.label -}}
          </span>
        </label>

        <c-select-controller
          data-action="redirect"
          class="flex max-w-64 min-w-0 gap-1.5 border px-5 py-3"
        >
          {% assign current = variation.products.value | first %}
          <img
            data-dom="flag"
            src="{{ current.featured_image | image_url: width: 33 }}"
            width="33"
            height="33"
            alt="{{ current.title }}"
            loading="lazy"
            class="size-8 shrink-0"
          >
          <select
            class="w-full min-w-0 truncate"
            name="variation-{{ variation_id }}"
            id="variation-{{ variation_id }}"
            data-dom="select"
          >
            {%- for related_product in variation.products.value -%}
              <option
                value="{{ related_product.id }}"
                data-url="{{ related_product.url }}"
                data-flag-src="{{ related_product.featured_image | image_url: width: 33 }}"
                {% if related_product.id == current.id %}
                  selected
                {% endif %}
              >
                {{- related_product.title -}}
              </option>
            {%- endfor -%}
          </select>
        </c-select-controller>
      </div>
    {%- endfor -%}
  {%- endif -%}

  {%- if block.settings.layout == 'link' -%}
    <div class="space-y-4">
      {%- for variation in variations -%}
        {%- if variation.label != blank -%}
          <p class="text-xs text-gray-500">{{- variation.label -}}</p>
        {%- endif -%}

        <div class="flex gap-1">
          {%- for related_product in variation.products.value -%}
            <a
              href="{{ related_product.url }}"
              class="flex size-16 justify-center border {% if related_product.id == id %}border-black{% else %}border-gray-200{% endif %}"
              aria-label="{{ related_product.title }}"
              {% if related_product.id == id %}
                aria-current="page"
              {% endif %}
            >
              {{-
                related_product.featured_image
                | image_url: width: 138
                | image_tag: class: 'size-full object-contain object-center'
              -}}
            </a>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

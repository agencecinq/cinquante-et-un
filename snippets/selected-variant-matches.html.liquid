{% doc %}
  Outputs `true` when `product.selected_or_first_available_variant` matches the
  selected option values. With `?option_values=` pointing at a combination that
  doesn't exist, Shopify falls back to the first available variant: blocks then
  treat the variant as `null` ("unavailable").

  Theme blocks can't share variables, so each one captures this snippet.

  @param {object} product - Product object.

  @example
  {%- liquid
    assign variant = product.selected_or_first_available_variant
    capture variant_matches
      render 'selected-variant-matches.html', product: product
    endcapture
    if variant_matches != 'true'
      assign variant = null
    endif
  -%}
{% enddoc %}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign matches = true

  for option in product.options_with_values
    if option.selected_value != blank and variant.options[forloop.index0] != option.selected_value
      assign matches = false
      break
    endif
  endfor

  echo matches
-%}

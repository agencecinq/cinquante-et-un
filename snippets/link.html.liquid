{% doc %}
  Renders a text link.

  @param {string} title - Link label (required to render).
  @param {string} [url] - `href` value.
  @param {string} [classes] - Extra classes (optional).
  @param {object} [block] - Theme block (`shopify_attributes`) (optional).
  @param {string} [attributes] - Raw HTML attributes, e.g. `target="_blank" rel="noopener noreferrer" aria-label="Open"`.

  @example
  {% render 'link.html', title: 'Shop', url: '/collections/all' %}

  @example
  {% render 'link.html',
    title: 'External',
    url: 'https://example.com',
    attributes: 'target="_blank" rel="noopener noreferrer"'
  %}
{% enddoc %}

{%- if title != blank -%}
  <a
    {% if url != blank %}
      href="{{ url }}"
    {% endif %}
    class="underline-offset-2 hover:underline{% if classes != blank %} {{ classes }}{% endif %}"
    {{ attributes }}
    {{ block.shopify_attributes }}
  >
    {{- title -}}
  </a>
{%- endif -%}

{% doc %}
  @param {string} id - Unique section ID.
  @param {string} [mode] - Display mode. Options: 'grid', 'slider'. Default: 'grid'. Optional.
  @param {object} [products] - List of products to display. Optional, required if mode is 'grid'.

  @example {%- render 'cart-recommendations.html', id: section.id -%}
{% enddoc %}

{% liquid
  assign mode = mode | default: 'grid'
%}

{%- capture content -%}
  <header>
    <p class="text-xs font-medium uppercase">{{- 'cart.recommendations.title' | t -}}</p>
  </header>

  {%- if mode == 'slider' -%}
    <div class="slideshow">
      <div id="slider-{{ id }}" class="slider scrollbar-hidden">
        {% for product in products %}
          {% assign price = product.price | money_with_currency %}
          <div
            class="slide gap"
            id="slider-{{ id }}-slide-{{ forloop.index0 }}"
            data-dom="slide"
          >
            <article class="border border-black p-3">
              <div class="flex w-72 items-center gap-3 sm:w-80">
                <div class="aspect-3/4 h-16 w-12 shrink-0 overflow-hidden border border-black bg-gray-100">
                  {%- if product.featured_media -%}
                    {{-
                      product.featured_media
                      | image_url: width: 118
                      | image_tag: class: 'size-full object-cover object-center'
                    -}}
                  {%- else -%}
                    {{- 'product-1' | placeholder_svg_tag: 'size-full object-cover object-center opacity-40' -}}
                  {%- endif -%}
                </div>

                <div class="min-w-0 grow space-y-3">
                  <p class="truncate text-sm">{{- product.title -}}</p>
                  {%- liquid
                    assign reco_title = 'cart.recommendations.add_to_cart' | t: price: price
                    assign reco_label = 'cart.recommendations.add_to_cart' | t
                  -%}
                  {% capture reco_attributes %}data-dom="button" aria-label="{{ reco_label | escape }}"{% endcapture %}
                  {% capture button %}
                    {%- render 'button.html',
                      title: reco_title,
                      type: 'submit',
                      classes: 'w-full',
                      variant: 'secondary',
                      attributes: reco_attributes
                    -%}
                  {%- endcapture -%}
                  {%- render 'add-to-cart.html', product: product, events: 'cartUpdate', button: button -%}
                </div>
              </div>
            </article>
          </div>
        {% endfor %}
      </div>
    </div>
  {%- endif -%}

  {%- if mode == 'grid' -%}
    <ul class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      {%- for product in products -%}
        <li>
          {%- render 'tease-product.html', product: product -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
{%- endcapture -%}

{%- if products -%}
  <div class="space-y-4" id="CartRecommandations-{{ id }}">
    {{- content -}}
  </div>
{%- endif -%}

{% doc %}
  @param {string} title - The title of the tab.
  @param {boolean} [active] - Whether the tab is active. Optional.
  @param {string} id - The unique identifier for the tab.
  @param {string} [classes] - Additional CSS classes to apply to the button. Optional.
{% enddoc %}

{% assign handle = title | handleize %}

<button
  type="button"
  class="{% if active %}is-active {% endif %}{% if classes %}{{ classes }} {% endif %}font-sans text-sm font-normal underline-offset-4 [&.is-active]:font-medium [&.is-active]:underline"
  role="tab"
  aria-selected="{% if active %}true{% else %}false{% endif %}"
  aria-controls="{{ handle }}-tabpanel-{{ id }}"
  id="{{ handle }}-tab-{{ id }}"
>
  {{- title -}}
</button>

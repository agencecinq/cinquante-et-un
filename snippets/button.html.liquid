{% doc %}
  Renders a button or link.

  If `url` is set → `<a>`. Otherwise → `<button>`.

  @param {string} title - Label (HTML allowed).
  @param {string} [url] - If present, renders an `<a href>`.
  @param {string} [classes] - Extra classes (optional).
  @param {string} [variant] - `primary` | `secondary` | `tertiary`. Default `primary`.
  @param {string} [type] - Button type when no `url`. Default `button`.
  @param {string} [icon] - Icon name for `use.html` (optional).
  @param {object} [block] - Theme block (`shopify_attributes`) (optional).
  @param {string} [attributes] - Raw HTML attributes, e.g. `id="x" form="y" disabled data-dom="button" aria-label="Open"`.

  @example
  {% render 'button.html', title: 'Shop', url: '/collections/all' %}

  @example
  {% render 'button.html',
    title: 'Add',
    type: 'submit',
    attributes: 'data-dom="button" disabled'
  %}
{% enddoc %}

{%- liquid
  assign classes = classes | default: '' | append: ' button'
  assign variant = variant | default: 'primary'

  if variant == 'primary'
    assign classes = classes | append: ' button--primary'
  endif

  if variant == 'secondary'
    assign classes = classes | append: ' button--secondary'
  endif

  if variant == 'tertiary'
    assign classes = classes | append: ' button--tertiary'
  endif
-%}

{%- if url != blank -%}
  <a
    href="{{ url }}"
    class="{{ classes | strip }}"
    {{ attributes }}
    {{ block.shopify_attributes }}
  >
    {%- if icon != blank -%}
      {%- render 'use.html', icon: icon, classes: 'size-4' -%}
    {%- endif -%}
    {{- title -}}
  </a>
{%- else -%}
  <button
    type="{{ type | default: 'button' }}"
    class="{{ classes | strip }}"
    {{ attributes }}
    {{ block.shopify_attributes }}
  >
    {%- if icon != blank -%}
      {%- render 'use.html', icon: icon, classes: 'size-4' -%}
    {%- endif -%}
    {{- title -}}
  </button>
{%- endif -%}

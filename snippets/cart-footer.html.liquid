{% doc %}
  Cart drawer footer snippet.

  @param {string} id - Unique section ID.

  @example {% render 'cart-footer.html', id: section.id %}
{% enddoc %}

{% liquid
  assign ids = cart.items | map: 'product_id' | uniq
  assign complementary_products = '' | split: ', '

  for item in cart.items
    assign products = item.product.metafields['shopify--discovery--product_recommendation'].complementary_products.value
    for product in products
      unless ids contains product.id
        assign complementary_products = product | concat: complementary_products
      endunless
    endfor
  endfor

  assign complementary_products = complementary_products | uniq | reverse
%}

<footer
  id="CartFooter-{{ id }}"
  class="js-cart-footer mt-auto border-t border-black bg-white"
>
  {%- if complementary_products != blank -%}
    <div class="space-y-4 px-5 pt-5">
      {%- render 'cart-recommendations.html', id: id, mode: 'slider', products: complementary_products -%}
    </div>
  {%- endif -%}

  <div class="space-y-4 px-5 py-5">
    {%- render 'cart-progress.html', total: cart.total_price, id: id -%}

    <div class="space-y-2">
      <div class="flex items-center justify-between gap-4">
        <span class="text-xs font-medium uppercase">{{- 'snippets.cart-footer.total' | t -}}</span>
        {%- render 'cart-total-price.html', classes: 'ml-auto', id: id -%}
      </div>
      {%- if settings.tax_included_text != blank -%}
        <div class="wysiwyg text-xs opacity-60">{{ settings.tax_included_text }}</div>
      {%- endif -%}
    </div>

    {%- assign title = 'cart.checkout' | t -%}

    {%- if cart.empty? -%}
      {%- render 'button.html',
        title: title,
        type: 'button',
        variant: 'primary',
        classes: 'w-full',
        attributes: 'disabled aria-disabled="true"'
      -%}
    {%- else -%}
      {%- assign form = 'CartForm-' | append: id -%}
      {% capture checkout_attributes %}name="checkout" form="{{ form }}"{% endcapture %}

      {%- render 'button.html',
        title: title,
        type: 'submit',
        variant: 'primary',
        classes: 'w-full',
        attributes: checkout_attributes
      -%}
    {%- endif -%}
  </div>
</footer>

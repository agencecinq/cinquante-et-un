{%- doc -%}
  Accordion group from section blocks (title + richtext).

  @param {object} items - Section blocks.
  @param {string} [classes] - Wrapper classes (optional).
  @param {string} [scheme] - Color scheme id (optional).
  @param {string} id - Section id (for stable DOM ids).
  @param {string} [title] - Section heading (optional).
  @param {string} [subtitle] - Eyebrow above the title (optional).
  @param {string} [link_url] - Optional link URL.
  @param {string} [link_title] - Optional link label.
  @param {string} [link_target] - Optional link target (`_blank`).

  @example
  {% render 'accordion-group.html',
    items: section.blocks,
    id: section.id,
    title: section.settings.title,
    link_url: section.settings.link_url,
    link_title: section.settings.link_title
  %}
{%- enddoc -%}

<div class="{{ classes }}{% if scheme != blank %} color-{{ scheme }}{% endif %}">
  <div class="container grid grid-cols-4 gap-x-2 gap-y-8 lg:grid-cols-12 lg:gap-x-4">
    <div class="col-span-full space-y-10 lg:sticky lg:inset-x-0 lg:top-0 lg:col-span-3">
      {%- if subtitle != blank or title != blank -%}
        <div class="space-y-2">
          {%- render 'subtitle.html', subtitle: subtitle -%}
          {%- if title != blank -%}
            <h2 class="text-xl font-semibold">{{- title -}}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if link_target == '_blank' -%}
        {%- assign attributes = 'target="_blank" rel="noopener noreferrer"' -%}
      {%- endif -%}
      {%- render 'link.html', url: link_url, title: link_title, attributes: attributes -%}
    </div>

    <cinq-accordion class="col-span-full lg:col-span-8" data-dom="accordion-group">
      {%- for item in items -%}
        {%- liquid
          assign item_title = item.settings.title | strip
          assign item_content = item.settings.content
          assign panel_id = 'accordion-' | append: id | append: '-' | append: forloop.index0
        -%}

        {%- if item_title != blank and item_content != blank -%}
          <div
            data-panel
            class="js-accordion-panel border-t border-gray-200"
            data-open="{% if forloop.first %}true{% else %}false{% endif %}"
            data-deselect="true"
          >
            <button
              data-header
              class="js-accordion-header group flex w-full items-center justify-between gap-2 py-6 text-start lg:gap-4"
              type="button"
              aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="{{ panel_id }}-body"
              id="{{ panel_id }}-header"
            >
              <strong class="text-sm font-semibold">{{- item_title -}}</strong>

              <span class="relative size-8 shrink-0 bg-gray-100">
                {%- liquid
                  render 'use.html', icon: 'plus', classes: 'size-3 absolute m-auto inset-0 block group-aria-expanded:hidden'
                  render 'use.html', icon: 'minus', classes: 'size-3 absolute m-auto inset-0 hidden group-aria-expanded:block'
                -%}
              </span>
            </button>

            <div
              id="{{ panel_id }}-body"
              role="region"
              aria-labelledby="{{ panel_id }}-header"
              {% unless forloop.first %}
                hidden
              {% endunless %}
            >
              <div data-inner class="js-accordion-inner wysiwyg max-w-3xl pb-6 text-sm">
                {{- item_content -}}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </cinq-accordion>
  </div>
</div>

{% doc %}
  Localization drawer — Shopify `{% form 'localization' %}` for country + language.

  @example {% render 'localization-drawer.html' %}
{% enddoc %}

{%- liquid
  assign show_country = false
  assign show_language = false
  if localization.available_countries.size > 1
    assign show_country = true
  endif
  if localization.available_languages.size > 1
    assign show_language = true
  endif
-%}

{%- if show_country or show_language -%}
  {%- capture content -%}
    <div class="flex h-full flex-col">
      {%- assign title = 'snippets.localization.title' | t -%}
      {%- render 'drawer-header.html', title: title, id: 'locale-currency-drawer' -%}

      <div class="space-y-8 px-5 py-8 lg:px-8">
        {%- if localization.country -%}
          <p class="text-sm opacity-60">
            {{- 'snippets.localization.text_html' | t: name: localization.country.name -}}
          </p>
        {%- endif -%}

        {%- form 'localization', return_to: request.path, class: 'space-y-8' -%}
          {%- if show_country -%}
            <div class="space-y-3">
              <p class="text-xs font-medium uppercase tracking-wide opacity-60">
                {{- 'snippets.localization.country_title' | t -}}
              </p>
              <c-select-controller class="relative block" data-action="submit">
                {% # theme-check-disable RemoteAsset %}
                <img
                  data-dom="flag"
                  src="https://flagcdn.com/{{ localization.country.iso_code | downcase }}.svg"
                  width="16"
                  height="16"
                  alt=""
                  loading="lazy"
                  class="pointer-events-none absolute inset-y-0 left-0 my-auto ml-4 size-4 overflow-hidden object-cover object-center"
                >

                <select
                  data-dom="select"
                  name="country_code"
                  class="w-full appearance-none border border-black bg-transparent py-3 pr-10 pl-12 text-sm"
                >
                  {%- for country in localization.available_countries -%}
                    <option
                      value="{{ country.iso_code }}"
                      data-flag-src="https://flagcdn.com/{{ country.iso_code | downcase }}.svg"
                      {% if country.iso_code == localization.country.iso_code %}
                        selected
                      {% endif %}
                    >
                      {{- country.name -}}
                      &nbsp;&lpar;{{- country.currency.symbol -}}&rpar;
                    </option>
                  {%- endfor -%}
                </select>

                {%- render 'use.html',
                  icon: 'chevron-down',
                  classes: 'pointer-events-none absolute inset-y-0 right-0 my-auto mr-4 size-3.5'
                -%}
              </c-select-controller>
            </div>
          {%- endif -%}

          {%- if show_language -%}
            <div class="space-y-3">
              <p class="text-xs font-medium uppercase tracking-wide opacity-60">
                {{- 'snippets.localization.language_title' | t -}}
              </p>
              <c-select-controller class="relative block" data-action="submit">
                <select
                  data-dom="select"
                  name="locale_code"
                  class="w-full appearance-none border border-black bg-transparent px-4 py-3 pr-10 text-sm"
                >
                  {%- for language in localization.available_languages -%}
                    <option
                      value="{{ language.iso_code }}"
                      {% if language.iso_code == localization.language.iso_code %}
                        selected
                      {% endif %}
                    >
                      {{- language.endonym_name -}}
                    </option>
                  {%- endfor -%}
                </select>
                {%- render 'use.html',
                  icon: 'chevron-down',
                  classes: 'pointer-events-none absolute inset-y-0 right-0 my-auto mr-4 size-3.5'
                -%}
              </c-select-controller>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  {%- endcapture -%}

  {%- render 'cinq-drawer.html',
    direction: 'from-right',
    content: content,
    id: 'locale-currency-drawer',
    background: 'bg-white'
  -%}
{%- endif -%}

{% doc %}
  @param {string} title - The title of the tab.
  @param {boolean} [active] - Whether the tab is active. Optional.
  @param {string} id - The unique identifier for the tab.
  @param {string} content - The content of the tab panel.
{% enddoc %}

{% assign handle = title | handleize %}

<section
  tabindex="{% if active %}0{% else %}-1{% endif %}"
  role="tabpanel"
  aria-labelledby="{{ handle }}-tab-{{ id }}"
  id="{{ handle }}-tabpanel-{{ id }}"
  {% unless active %}
    hidden
  {% endunless %}
  class="space-y-2.5 font-sans text-sm font-light"
>
  {%- assign plain = content | strip_html | strip_newlines | strip -%}
  {%- if plain.size > 64 -%}
    <div id="{{ handle }}-short-{{ id }}">
      {{- plain | truncate: 64 -}}
    </div>
    <div id="{{ handle }}-full-{{ id }}" hidden>{{ content }}</div>
    <cinq-disclosure-button>
      <button
        type="button"
        id="{{ handle }}-btn"
        aria-expanded="false"
        aria-controls="{{ handle }}-full-{{ id }}"
        class="underline underline-offset-2"
        data-disclosure-short="{{ handle }}-short-{{ id }}"
        data-readless-title="{{ 'snippets.product-tab.readless' | t }}"
        data-readmore-title="{{ 'snippets.product-tab.readmore' | t }}"
      >
        <span>{{ 'snippets.product-tab.readmore' | t }}</span>
      </button>
    </cinq-disclosure-button>
  {%- else -%}
    {{- content -}}
  {%- endif -%}
</section>

{%- doc -%}
  Cart drawer empty snippet.

  @param {string} id - Unique section ID.

  @example {% render 'cart-empty', id: section.id %}
{%- enddoc -%}

{%- render 'cart-header.html', id: id -%}

<div id="CartDrawerEmpty-{{ id }}" class="js-cart-items flex grow items-center justify-center p-5">
  <div class="space-y-10 text-center">
    <p class="text-lg">
      {{- 'cart.drawer.empty.message' | t -}}
    </p>

    {%- liquid
      assign title = 'snippets.cart-empty.title' | t
      assign url = '/collections/all'

      if settings.cart_empty_title != blank
        assign title = settings.cart_empty_title
      endif

      if settings.cart_empty_url != blank
        assign url = settings.cart_empty_url
      endif

      render 'button.html', title: title, tag: 'a', url: url
    -%}
  </div>
</div>

{%- render 'cart-footer.html', id: id -%}

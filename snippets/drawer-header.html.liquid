{% doc %}
  Renders a drawer header.

  @param [title] - {String} The title of the drawer.
  @param id - {String} The id of the drawer.
{% enddoc %}

<header class="flex items-center justify-between gap-2 px-5 py-8 lg:gap-4 lg:px-8">
  {%- if title != blank -%}
    <p class="text-sm font-medium">{{- title -}}</p>
  {%- endif -%}

  <cinq-drawer-button class="ms-auto flex items-center justify-center">
    <button
      data-dom="button"
      aria-controls="{{ id }}"
      aria-expanded="false"
      type="button"
      aria-label="{{ 'snippets.drawer-header.close' | t }}"
    >
      {%- render 'use.html', icon: 'times', classes: 'size-3.5' -%}
    </button>
  </cinq-drawer-button>
</header>

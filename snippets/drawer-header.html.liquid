{% doc %}
  Renders a drawer header.

  @param [title] - {String} The title of the drawer.
  @param id - {String} The id of the drawer dialog. The title gets `{id}-title`, to pass as the drawer `label`.
{% enddoc %}

<header class="flex items-center justify-between gap-2 px-5 py-8 lg:gap-4 lg:px-8">
  {%- if title != blank -%}
    <p id="{{ id }}-title" class="text-sm font-medium">{{- title -}}</p>
  {%- endif -%}

  <div class="ms-auto flex items-center justify-center">
    <button
      commandfor="{{ id }}"
      command="request-close"
      type="button"
      aria-label="{{ 'snippets.drawer-header.close' | t }}"
    >
      {%- render 'use.html', icon: 'times', classes: 'size-3.5' -%}
    </button>
  </div>
</header>

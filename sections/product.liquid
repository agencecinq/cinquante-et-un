{% comment %}
  Product page — media gallery, and theme blocks for the product info (`blocks/product-*.liquid`).
  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{%- liquid
  assign padding_top_mobile = section.settings.padding_top | times: 0.6 | divided_by: 16.00
  assign padding_top_desktop = section.settings.padding_top | divided_by: 16.00
  assign padding_bottom_mobile = section.settings.padding_bottom | times: 0.6 | divided_by: 16.00
  assign padding_bottom_desktop = section.settings.padding_bottom | divided_by: 16.00

  if section.settings.compensate_header
    assign padding_top_mobile = 'calc(' | append: padding_top_mobile | append: 'rem + var(--header-height, 4.5rem))'
    assign padding_top_desktop = 'calc(' | append: padding_top_desktop | append: 'rem + var(--header-height, 4.5rem))'
  else
    assign padding_top_mobile = padding_top_mobile | append: 'rem'
    assign padding_top_desktop = padding_top_desktop | append: 'rem'
  endif

  assign variant = product.selected_or_first_available_variant

  capture variant_matches
    render 'selected-variant-matches.html', product: product
  endcapture

  if variant_matches != 'true'
    assign variant = null
  endif

  assign slideshow_cid = 'slideshow-' | append: section.id | append: '-' | append: product.id

  # Gallery starts on the selected variant's media (e.g. `?variant=`); `c-product-gallery` follows later changes.
  assign gallery = product.media

  if variant.featured_media
    assign other_media = product.media | reject: 'id', variant.featured_media.id
    assign gallery = product.media | where: 'id', variant.featured_media.id | concat: other_media
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ padding_top_mobile }};
    padding-bottom: {{ padding_bottom_mobile }}rem;
  }

  @media (width >= 64rem) {
    .section-{{ section.id }}-padding {
      padding-top: {{ padding_top_desktop }};
      padding-bottom: {{ padding_bottom_desktop }}rem;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="container">
    <div class="grid grid-cols-4 gap-x-2 gap-y-8 lg:grid-cols-12 lg:items-start lg:gap-x-4 lg:gap-y-0">
      <div class="col-span-4 lg:sticky lg:top-4 lg:col-span-6">
        {%- if product.media.size == 0 -%}
          <div class="aspect-3/4 border border-black bg-gray-100">
            {{- 'product-1' | placeholder_svg_tag: 'size-full object-cover object-center opacity-40' -}}
          </div>
        {%- else -%}
          <c-product-gallery class="block" data-product-id="{{ product.id }}">
            <c-slideshow cid="{{ slideshow_cid }}" class="relative block">
              <div
                class="scrollbar-hidden flex aspect-3/4 snap-x snap-mandatory overflow-x-auto scroll-smooth border border-black"
                data-dom="slider-{{ slideshow_cid }}"
                aria-label="{{ product.title | escape }}"
              >
                {%- for media in gallery -%}
                  <div
                    class="relative w-full shrink-0 snap-center"
                    data-dom="slide-{{ slideshow_cid }}"
                    data-media-id="{{ media.id }}"
                  >
                    {%- if media.media_type == 'image' -%}
                      {%- assign alt = media.alt | default: product.title -%}
                      {{-
                        media
                        | image_url: width: 1440
                        | image_tag: class: 'size-full object-cover object-center', alt: alt
                      -}}
                    {%- elsif media.media_type == 'video' -%}
                      {{-
                        media
                        | video_tag:
                          autoplay: true,
                          loop: true,
                          muted: true,
                          playsinline: true,
                          image_size: '1440x',
                          class: 'size-full object-cover object-center'
                      -}}
                    {%- elsif media.media_type == 'external_video' -%}
                      {{- media | external_video_tag: class: 'size-full object-cover object-center' -}}
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>

              {%- if product.media.size > 1 -%}
                <div class="mt-2 flex items-center justify-between gap-2">
                  {%- liquid
                    assign previous_label = 'sections.product.previous' | t
                    assign previous_dom = 'previous-' | append: slideshow_cid
                    assign next_label = 'sections.product.next' | t
                    assign next_dom = 'next-' | append: slideshow_cid
                  -%}
                  {% capture previous_attributes %}data-dom="{{ previous_dom }}" aria-label="{{ previous_label | escape }}"{% endcapture %}
                  {% capture next_attributes %}data-dom="{{ next_dom }}" aria-label="{{ next_label | escape }}"{% endcapture %}
                  {%- render 'button.html',
                    variant: 'tertiary',
                    icon: 'chevron-left',
                    title: '',
                    attributes: previous_attributes
                  -%}
                  <div class="flex flex-wrap justify-center gap-1" data-dom="controls-{{ slideshow_cid }}">
                    {%- for media in product.media -%}
                      <button
                        type="button"
                        class="size-2 border border-black bg-transparent aria-current:bg-black"
                        aria-label="{{ 'sections.product.thumbnail' | t: number: forloop.index }}"
                      ></button>
                    {%- endfor -%}
                  </div>
                  {%- render 'button.html',
                    variant: 'tertiary',
                    icon: 'chevron-right',
                    title: '',
                    attributes: next_attributes
                  -%}
                </div>
              {%- endif -%}
            </c-slideshow>
          </c-product-gallery>
        {%- endif -%}
      </div>

      <div class="col-span-4 space-y-6 lg:col-span-5 lg:col-start-8">
        {%- content_for 'blocks' -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.product.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.shared.settings.padding.header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.shared.settings.padding.top.label",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.shared.settings.padding.bottom.label",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "compensate_header",
      "label": "t:sections.shared.settings.compensate_header.label",
      "info": "t:sections.shared.settings.compensate_header.info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.shared.settings.color_scheme.header.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.settings.color_scheme.label",
      "default": "background-1"
    }
  ],
  "blocks": [
    {
      "type": "breadcrumb"
    },
    {
      "type": "product-title"
    },
    {
      "type": "product-price"
    },
    {
      "type": "product-variant-picker"
    },
    {
      "type": "product-buy-buttons"
    },
    {
      "type": "product-reassurance"
    },
    {
      "type": "accordion-group"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}

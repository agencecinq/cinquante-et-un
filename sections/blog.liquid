{% comment %}
  This section is used in the blog template to render the blog page listing all
  articles within a blog.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

{%- liquid
  assign padding_top_mobile = section.settings.padding_top | times: 0.6 | divided_by: 16.00
  assign padding_top_desktop = section.settings.padding_top | divided_by: 16.00
  assign padding_bottom_mobile = section.settings.padding_bottom | times: 0.6 | divided_by: 16.00
  assign padding_bottom_desktop = section.settings.padding_bottom | divided_by: 16.00

  if section.settings.compensate_header
    assign padding_top_mobile = 'calc(' | append: padding_top_mobile | append: 'rem + var(--header-height, 4.5rem))'
    assign padding_top_desktop = 'calc(' | append: padding_top_desktop | append: 'rem + var(--header-height, 4.5rem))'
  else
    assign padding_top_mobile = padding_top_mobile | append: 'rem'
    assign padding_top_desktop = padding_top_desktop | append: 'rem'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ padding_top_mobile }};
    padding-bottom: {{ padding_bottom_mobile }}rem;
  }

  @media (width >= 64rem) {
    .section-{{ section.id }}-padding {
      padding-top: {{ padding_top_desktop }};
      padding-bottom: {{ padding_bottom_desktop }}rem;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} space-y-12">
  <div class="container space-y-6 text-center">
    <div class="space-y-2">
      {%- render 'subtitle.html', subtitle: section.settings.subtitle -%}
      <h1 class="text-base font-semibold">
        <a href="{{ blog.url }}">
          {{- section.settings.title | default: blog.title -}}
        </a>
      </h1>
    </div>

    {%- if blog.all_tags.size > 0 -%}
      <ul class="flex flex-wrap items-center justify-center gap-x-12 gap-y-2.5">
        {%- for tag in blog.all_tags -%}
          <li>
            <a
              href="{{ blog.url }}/tagged/{{ tag | handleize }}"
              class="text-xs uppercase{% if current_tags contains tag %} underline{% endif %}"
              title="{{ 'sections.blog.filter_by_tag' | t: tag: tag }}"
            >
              {{- tag -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {% paginate blog.articles by section.settings.articles_per_page %}
    {%- liquid
      assign current = paginate.current_offset | plus: blog.articles.size
      assign displayed_count = 'sections.blog.displayed-count' | t: current: current, total: blog.articles_count
    -%}

    {%- capture articles_grid -%}
      <ul
        id="BlogArticles-{{ section.id }}"
        data-dom="container"
        class="container grid grid-cols-2 gap-4 lg:grid-cols-4"
      >
        {%- for article in blog.articles -%}
          <li>
            {%- render 'tease-article.html',
              article: article,
              show_tags: section.settings.show_tags,
              show_excerpt: section.settings.show_excerpt
            -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endcapture -%}

    {%- if paginate.pages > 1 -%}
      <c-load-more
        id="BlogLoadMore-{{ section.id }}"
        data-section-id="{{ section.id }}"
        data-items-id="BlogArticles-{{ section.id }}"
        data-action="{{ paginate.next.url }}"
        class="flex flex-col gap-y-10 transition-opacity duration-300 ease-out aria-busy:cursor-wait aria-busy:opacity-50 lg:gap-y-12"
      >
        {{ articles_grid }}

        <div class="container space-y-4 text-center">
          <div data-dom="displayed-count" class="text-center text-sm">
            {{- displayed_count -}}
          </div>
          {%- liquid
            assign title = 'sections.blog.see-more' | t
            assign button_attributes = 'data-dom="load-more-button" data-events-click="loadMore"'
            if paginate.next.url == blank
              assign button_attributes = button_attributes | append: ' hidden'
            endif
          -%}
          {%- render 'button.html', title: title, variant: 'tertiary', attributes: button_attributes -%}
        </div>
      </c-load-more>
    {%- else -%}
      {{ articles_grid }}
    {%- endif -%}
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "t:sections.blog.name",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:sections.shared.settings.subtitle.label",
      "info": "t:sections.shared.settings.subtitle.info"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.blog.settings.title.label",
      "default": "t:sections.blog.settings.title.default",
      "info": "t:sections.blog.settings.title.info"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12,
      "label": "t:sections.blog.settings.articles_per_page.label"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:sections.blog.settings.show_tags.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:sections.blog.settings.show_excerpt.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.shared.settings.padding.header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 16,
      "max": 116,
      "step": 1,
      "unit": "px",
      "label": "t:sections.shared.settings.padding.top.label",
      "info": "t:sections.shared.settings.padding.top.info",
      "default": 105
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 16,
      "max": 116,
      "step": 1,
      "unit": "px",
      "label": "t:sections.shared.settings.padding.bottom.label",
      "info": "t:sections.shared.settings.padding.bottom.info",
      "default": 59
    },
    {
      "type": "checkbox",
      "id": "compensate_header",
      "label": "t:sections.shared.settings.compensate_header.label",
      "info": "t:sections.shared.settings.compensate_header.info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.shared.settings.color_scheme.header.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.settings.color_scheme.label",
      "default": "background-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.blog.preset.name"
    }
  ]
}
{% endschema %}

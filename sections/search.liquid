{% comment %}
  Search template section: form + results (products, articles, pages).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | divided_by: 16.00 }}rem;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | divided_by: 16.00 }}rem;
  }

  @media (width >= 64rem) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 16.00 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 16.00 }}rem;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="container space-y-8">
    <div class="space-y-4">
      <h1 class="text-xl font-semibold">{{ 'search.title' | t }}</h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="relative">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
          aria-label="{{ 'search.placeholder' | t }}"
          class="w-full border border-black bg-transparent py-3 pr-12 pl-4 placeholder:opacity-40"
        >
        <button
          type="submit"
          class="absolute inset-y-0 right-0 my-auto mr-3 size-5"
          aria-label="{{ 'search.submit' | t }}"
        >
          {%- render 'use.html', icon: 'search', classes: 'size-5' -%}
        </button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p>{{ 'search.no_results_html' | t: terms: search.terms }}</p>
      {%- else -%}
        <p>{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>

        {%- paginate search.results by section.settings.products_per_page -%}
          <ul class="grid grid-cols-2 gap-4 lg:grid-cols-4">
            {%- for result in search.results -%}
              <li>
                {%- if result.object_type == 'product' -%}
                  {%- render 'tease-product.html', product: result -%}
                {%- else -%}
                  {%- assign featured_image = result.image | default: result.featured_image -%}
                  <article class="flex h-full flex-col gap-3 border border-black p-4">
                    {%- if featured_image != blank -%}
                      <a
                        href="{{ result.url }}"
                        class="block aspect-3/4 overflow-hidden bg-gray-100"
                        tabindex="-1"
                        aria-hidden="true"
                      >
                        {{-
                          featured_image
                          | image_url: width: 600
                          | image_tag: class: 'size-full object-cover', loading: 'lazy', alt: result.title
                        -}}
                      </a>
                    {%- endif -%}
                    <p class="text-xs uppercase opacity-50">{{ result.object_type }}</p>
                    <a href="{{ result.url }}" class="font-medium hover:underline">{{ result.title }}</a>
                  </article>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          {%- if paginate.pages > 1 -%}
            <div class="flex justify-center">
              {%- render 'pagination.html', paginate: paginate -%}
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.search.name",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "t:sections.search.settings.products_per_page.label"
    },
    {
      "type": "header",
      "content": "t:sections.shared.settings.padding.header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.shared.settings.padding.top.label",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.shared.settings.padding.bottom.label",
      "default": 36
    },
    {
      "type": "header",
      "content": "t:sections.shared.settings.color_scheme.header.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.settings.color_scheme.label",
      "default": "background-1"
    }
  ]
}
{% endschema %}

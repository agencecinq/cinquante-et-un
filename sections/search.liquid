{% comment %}
  Search template section: form + results (products, articles, pages).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

{%- liquid
  assign padding_top_mobile = section.settings.padding_top | times: 0.6 | divided_by: 16.00
  assign padding_top_desktop = section.settings.padding_top | divided_by: 16.00
  assign padding_bottom_mobile = section.settings.padding_bottom | times: 0.6 | divided_by: 16.00
  assign padding_bottom_desktop = section.settings.padding_bottom | divided_by: 16.00

  if section.settings.compensate_header
    assign padding_top_mobile = 'calc(' | append: padding_top_mobile | append: 'rem + var(--header-height, 4.5rem))'
    assign padding_top_desktop = 'calc(' | append: padding_top_desktop | append: 'rem + var(--header-height, 4.5rem))'
  else
    assign padding_top_mobile = padding_top_mobile | append: 'rem'
    assign padding_top_desktop = padding_top_desktop | append: 'rem'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ padding_top_mobile }};
    padding-bottom: {{ padding_bottom_mobile }}rem;
  }

  @media (width >= 64rem) {
    .section-{{ section.id }}-padding {
      padding-top: {{ padding_top_desktop }};
      padding-bottom: {{ padding_bottom_desktop }}rem;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="container space-y-8">
    <div class="space-y-4">
      <h1 class="text-xl font-semibold">{{ 'search.title' | t }}</h1>

      {%- render 'search-form.html', id: 'page', value: search.terms -%}
    </div>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p>{{ 'search.no_results_html' | t: terms: search.terms }}</p>
      {%- else -%}
        <p>{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>

        {%- paginate search.results by section.settings.products_per_page -%}
          <ul class="grid grid-cols-2 gap-4 lg:grid-cols-4">
            {%- for result in search.results -%}
              <li>
                {%- if result.object_type == 'product' -%}
                  {%- render 'tease-product.html', product: result -%}
                {%- elsif result.object_type == 'article' -%}
                  {%- render 'tease-article.html', article: result -%}
                {%- else -%}
                  {%- assign featured_image = result.image | default: result.featured_image -%}
                  <article class="surface surface--padded flex h-full flex-col gap-3">
                    {%- if featured_image != blank -%}
                      <a
                        href="{{ result.url }}"
                        class="block aspect-3/4 overflow-hidden bg-gray-100"
                        tabindex="-1"
                        aria-hidden="true"
                      >
                        {{-
                          featured_image
                          | image_url: width: 600
                          | image_tag: class: 'size-full object-cover', loading: 'lazy', alt: result.title
                        -}}
                      </a>
                    {%- endif -%}
                    <p class="text-xs uppercase opacity-50">{{ result.object_type }}</p>
                    <a href="{{ result.url }}" class="font-medium hover:underline">{{ result.title }}</a>
                  </article>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          {%- if paginate.pages > 1 -%}
            <div class="flex justify-center">
              {%- render 'pagination.html', paginate: paginate -%}
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.search.name",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "t:sections.search.settings.products_per_page.label"
    },
    {
      "type": "header",
      "content": "t:sections.shared.settings.padding.header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.shared.settings.padding.top.label",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.shared.settings.padding.bottom.label",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "compensate_header",
      "label": "t:sections.shared.settings.compensate_header.label",
      "info": "t:sections.shared.settings.compensate_header.info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.shared.settings.color_scheme.header.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.settings.color_scheme.label",
      "default": "background-1"
    }
  ]
}
{% endschema %}

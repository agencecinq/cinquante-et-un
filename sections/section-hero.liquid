{%- liquid
  assign padding_top_mobile = section.settings.padding_top | times: 0.6 | divided_by: 16.00
  assign padding_top_desktop = section.settings.padding_top | divided_by: 16.00
  assign padding_bottom_mobile = section.settings.padding_bottom | times: 0.6 | divided_by: 16.00
  assign padding_bottom_desktop = section.settings.padding_bottom | divided_by: 16.00

  if section.settings.compensate_header
    assign padding_top_mobile = 'calc(' | append: padding_top_mobile | append: 'rem + var(--header-height, 4.5rem))'
    assign padding_top_desktop = 'calc(' | append: padding_top_desktop | append: 'rem + var(--header-height, 4.5rem))'
  else
    assign padding_top_mobile = padding_top_mobile | append: 'rem'
    assign padding_top_desktop = padding_top_desktop | append: 'rem'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ padding_top_mobile }};
    padding-bottom: {{ padding_bottom_mobile }}rem;
  }

  @media (width >= 64rem) {
    .section-{{ section.id }}-padding {
      padding-top: {{ padding_top_desktop }};
      padding-bottom: {{ padding_bottom_desktop }}rem;
    }
  }
{%- endstyle -%}

{% capture media %}
 {%- liquid
 assign show_mobile = false
 if section.settings.video_mobile != blank or section.settings.image_mobile != blank
 assign show_mobile = true
 endif
 -%}

 {%- if show_mobile -%}
 <div class="absolute inset-0 z-10 lg:hidden">
 {%- if section.settings.video_mobile != blank -%}
 {{-
 section.settings.video_mobile
 | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'size-full object-cover object-center', image_size: '390x', fetchpriority: 'high'
 -}}
 {%- elsif section.settings.image_mobile != blank -%}
 {%- render 'image.html', width: 1920, image: section.settings.image_mobile, class: 'size-full object-cover object-center' -%}
 {%- endif -%}
 </div>
 {%- endif -%}

 <div class="absolute inset-0 z-10 border border-black {% if show_mobile %}hidden lg:block{% endif %}">
 {%- if section.settings.video != blank -%}
 {{-
 section.settings.video
 | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'size-full object-cover object-center', image_size: '1440x', fetchpriority: 'high'
 -}}
 {%- elsif section.settings.image != blank -%}
 {%- render 'image.html', width: 2880, image: section.settings.image, class: 'size-full object-cover object-center' -%}
 {%- else -%}
 {{- 'hero-apparel-1' | placeholder_svg_tag: 'size-full object-cover object-center opacity-40' -}}
 {%- endif -%}
 </div>
{% endcapture %}

{% capture blocks %}
 {%- content_for 'blocks' -%}
{% endcapture %}

{%- liquid
  assign classes = 'lg:aspect-16/9 relative aspect-9/16 max-h-screen min-w-full'

  if section.settings.show_media_overlay
    assign classes = classes | append: ' after:absolute after:inset-0 after:z-20 after:size-full after:[background:linear-gradient(180deg,rgba(0,0,0,0)_0%,rgba(0,0,0,0.2)_100%)]'
  endif
-%}

{% if section.settings.full_bleed %}
  <div class="container section-{{ section.id }}-padding">
    <div class="overflow-hidden color-{{ section.settings.color_scheme }} {{ classes }}">
      <div class="{{ section.settings.alignment_vertical }} absolute inset-0 z-30 grid size-full grid-cols-12 gap-5 px-2.5 py-14 lg:px-16">
        <div class="col-span-full {{ section.settings.space_between }} text-center lg:col-span-4 {{ section.settings.alignment_horizontal }}">
          {{- blocks -}}
        </div>
      </div>

      {{- media -}}
    </div>
  </div>
{% else %}
  <div class="color-{{ section.settings.color_scheme }} {{ classes }}">
    <div class="z-30 container py-14 {{ section.settings.alignment_vertical }} section-{{ section.id }}-padding absolute inset-0 grid grid-cols-12 gap-5">
      <div class="col-span-full {{ section.settings.space_between }} text-center lg:col-span-4 {{ section.settings.alignment_horizontal }}">
        {{- blocks -}}
      </div>
    </div>

    {{- media -}}
  </div>
{% endif %}


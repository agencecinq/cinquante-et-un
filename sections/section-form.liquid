{% comment %}
  Contact form section (Shopify contact form).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page#contact-form
{% endcomment %}

{%- liquid
  assign padding_top_mobile = section.settings.padding_top | times: 0.6 | divided_by: 16.00
  assign padding_top_desktop = section.settings.padding_top | divided_by: 16.00
  assign padding_bottom_mobile = section.settings.padding_bottom | times: 0.6 | divided_by: 16.00
  assign padding_bottom_desktop = section.settings.padding_bottom | divided_by: 16.00

  if section.settings.compensate_header
    assign padding_top_mobile = 'calc(' | append: padding_top_mobile | append: 'rem + var(--header-height, 4.5rem))'
    assign padding_top_desktop = 'calc(' | append: padding_top_desktop | append: 'rem + var(--header-height, 4.5rem))'
  else
    assign padding_top_mobile = padding_top_mobile | append: 'rem'
    assign padding_top_desktop = padding_top_desktop | append: 'rem'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ padding_top_mobile }};
    padding-bottom: {{ padding_bottom_mobile }}rem;
  }

  @media (width >= 64rem) {
    .section-{{ section.id }}-padding {
      padding-top: {{ padding_top_desktop }};
      padding-bottom: {{ padding_bottom_desktop }}rem;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="grid grid-cols-4 gap-x-2.5 gap-y-8 lg:grid-cols-12 lg:gap-x-4">
      <div class="col-span-4 space-y-8 lg:col-span-6 lg:col-start-4">
        {%- if section.settings.show_breadcrumb -%}
          {%- render 'breadcrumb.html', classes: 'text-xs opacity-60' -%}
        {%- endif -%}

        <div class="space-y-2">
          {%- render 'subtitle.html', subtitle: section.settings.subtitle -%}
          {%- if section.settings.title != blank -%}
            <h2 class="text-base font-semibold">{{ section.settings.title }}</h2>
          {%- endif -%}
        </div>

        {%- if section.settings.text != blank -%}
          <div class="wysiwyg text-sm opacity-70">{{ section.settings.text }}</div>
        {%- endif -%}

        {% form 'contact', id: 'ContactForm', class: 'space-y-4' %}
          {%- if form.posted_successfully? -%}
            <p class="surface px-4 py-3 text-sm" role="status" tabindex="-1" autofocus>
              {{- 'sections.form.form.success' | t -}}
            </p>
          {%- else -%}
            {%- if form.errors -%}
              <div class="surface px-4 py-3 text-sm" role="alert">
                {{- form.errors | default_errors -}}
              </div>
            {%- endif -%}

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="space-y-2">
                <label class="text-xs font-medium" for="ContactForm-first-name-{{ section.id }}">
                  {{- 'sections.form.form.first-name.label' | t -}}
                </label>
                <input
                  type="text"
                  id="ContactForm-first-name-{{ section.id }}"
                  name="contact[first_name]"
                  autocomplete="given-name"
                  required
                  placeholder="{{ 'sections.form.form.first-name.placeholder' | t }}"
                  class="w-full border border-black bg-transparent px-3 py-3 text-sm placeholder:opacity-40"
                  value="{% if form.first_name %}{{ form.first_name }}{% elsif customer %}{{ customer.first_name }}{% endif %}"
                >
              </div>

              <div class="space-y-2">
                <label class="text-xs font-medium" for="ContactForm-last-name-{{ section.id }}">
                  {{- 'sections.form.form.last-name.label' | t -}}
                </label>
                <input
                  type="text"
                  id="ContactForm-last-name-{{ section.id }}"
                  name="contact[last_name]"
                  autocomplete="family-name"
                  required
                  placeholder="{{ 'sections.form.form.last-name.placeholder' | t }}"
                  class="w-full border border-black bg-transparent px-3 py-3 text-sm placeholder:opacity-40"
                  value="{% if form.last_name %}{{ form.last_name }}{% elsif customer %}{{ customer.last_name }}{% endif %}"
                >
              </div>
            </div>

            <div class="space-y-2">
              <label class="text-xs font-medium" for="ContactForm-email-{{ section.id }}">
                {{- 'sections.form.form.email.label' | t -}}
              </label>
              <input
                type="email"
                id="ContactForm-email-{{ section.id }}"
                name="contact[email]"
                autocomplete="email"
                required
                spellcheck="false"
                autocapitalize="off"
                placeholder="{{ 'sections.form.form.email.placeholder' | t }}"
                class="w-full border border-black bg-transparent px-3 py-3 text-sm placeholder:opacity-40"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="ContactForm-email-error-{{ section.id }}"
                {% endif %}
              >
            </div>

            <div class="space-y-2">
              <label class="text-xs font-medium" for="ContactForm-order-number-{{ section.id }}">
                {{- 'sections.form.form.order-number.label' | t -}}
              </label>
              <input
                type="text"
                id="ContactForm-order-number-{{ section.id }}"
                name="contact[order_number]"
                placeholder="{{ 'sections.form.form.order-number.placeholder' | t }}"
                class="w-full border border-black bg-transparent px-3 py-3 text-sm placeholder:opacity-40"
                value="{{ form.order_number }}"
              >
            </div>

            <div class="space-y-2">
              <label class="text-xs font-medium" for="ContactForm-topic-{{ section.id }}">
                {{- 'sections.form.form.topic.label' | t -}}
              </label>
              <select
                id="ContactForm-topic-{{ section.id }}"
                name="contact[topic]"
                class="w-full border border-black bg-transparent px-3 py-3 text-sm"
              >
                <option value="" disabled selected>
                  {{- 'sections.form.form.topic.placeholder' | t -}}
                </option>
                <option value="{{ 'sections.form.form.topic.option-1' | t }}">
                  {{- 'sections.form.form.topic.option-1' | t -}}
                </option>
                <option value="{{ 'sections.form.form.topic.option-2' | t }}">
                  {{- 'sections.form.form.topic.option-2' | t -}}
                </option>
                <option value="{{ 'sections.form.form.topic.option-3' | t }}">
                  {{- 'sections.form.form.topic.option-3' | t -}}
                </option>
                <option value="{{ 'sections.form.form.topic.option-4' | t }}">
                  {{- 'sections.form.form.topic.option-4' | t -}}
                </option>
              </select>
            </div>

            <div class="space-y-2">
              <label class="text-xs font-medium" for="ContactForm-body-{{ section.id }}">
                {{- 'sections.form.form.message.label' | t -}}
              </label>
              <textarea
                id="ContactForm-body-{{ section.id }}"
                name="contact[body]"
                rows="6"
                required
                placeholder="{{ 'sections.form.form.message.placeholder' | t }}"
                class="w-full resize-y border border-black bg-transparent px-3 py-3 text-sm placeholder:opacity-40"
              >{{- form.body -}}</textarea>
            </div>

            {%- assign submit_title = 'sections.form.form.submit' | t -%}
            {%- render 'button.html',
              title: submit_title,
              type: 'submit',
              variant: 'primary',
              classes: 'w-full sm:w-auto'
            -%}
          {%- endif -%}
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.form.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:sections.form.settings.show_breadcrumb.label",
      "info": "t:sections.form.settings.show_breadcrumb.info",
      "default": false
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:sections.shared.settings.subtitle.label",
      "info": "t:sections.shared.settings.subtitle.info"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.form.settings.title.label",
      "info": "t:sections.form.settings.title.info",
      "default": "Contact"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.form.settings.text.label",
      "info": "t:sections.form.settings.text.info"
    },
    {
      "type": "header",
      "content": "t:sections.shared.settings.padding.header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.shared.settings.padding.top.label",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.shared.settings.padding.bottom.label",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "compensate_header",
      "label": "t:sections.shared.settings.compensate_header.label",
      "info": "t:sections.shared.settings.compensate_header.info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.shared.settings.color_scheme.header.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.settings.color_scheme.label",
      "default": "background-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.form.presets.name"
    }
  ]
}
{% endschema %}

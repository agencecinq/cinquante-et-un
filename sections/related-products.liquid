{% comment %}
  Related products grid for the product template.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | divided_by: 16.00 }}rem;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | divided_by: 16.00 }}rem;
  }

  @media (width >= 64rem) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 16.00 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 16.00 }}rem;
    }
  }
{%- endstyle -%}

{%- liquid
  assign limit = section.settings.products_to_show | default: 4
  assign related_collection = product.collections.first
-%}

{%- if related_collection != blank and related_collection.products_count > 1 -%}
  <div class="color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
    <div class="container space-y-6">
      <div class="space-y-2">
        {%- render 'subtitle.html', subtitle: section.settings.subtitle -%}
        {%- if section.settings.title != blank -%}
          <h2 class="text-lg font-semibold">{{- section.settings.title -}}</h2>
        {%- endif -%}
      </div>

      <ul class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        {%- assign shown = 0 -%}
        {%- for related in related_collection.products -%}
          {%- if related.id == product.id -%}
            {%- continue -%}
          {%- endif -%}
          {%- if shown >= limit -%}
            {%- break -%}
          {%- endif -%}
          <li>
            {%- render 'tease-product.html', product: related, quick_add: section.settings.show_quick_add -%}
          </li>
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.related-products.name",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:sections.shared.settings.subtitle.label",
      "info": "t:sections.shared.settings.subtitle.info"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.related-products.settings.title.label",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "t:sections.related-products.settings.products_to_show.label",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:sections.related-products.settings.show_quick_add.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.shared.settings.padding.header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.shared.settings.padding.top.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.shared.settings.padding.bottom.label",
      "default": 48
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.settings.color_scheme.label",
      "default": "background-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.related-products.name"
    }
  ]
}
{% endschema %}

{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | divided_by: 16.00 }}rem;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | divided_by: 16.00 }}rem;
  }

  @media (width >= 64rem) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 16.00 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 16.00 }}rem;
    }
  }
{% endstyle %}

<main
  class="section-{{ section.id }}-padding relative flex min-h-screen flex-col items-center gap-2.5 bg-gray-200 after:absolute after:inset-0 after:z-10 after:size-full after:bg-white/5 after:opacity-90 lg:gap-5"
>
  <header class="relative z-20">
    <a
      href="{{ routes.root_url }}"
      class="text-sm font-semibold tracking-wide text-white uppercase"
      aria-label="{{ shop.name }}"
    >
      {{- shop.name -}}
    </a>
  </header>

  <div class="relative z-20 my-auto px-2.5 lg:px-5">
    <div class="w-full max-w-sm space-y-5 bg-white/75 py-6">
      {%- if section.settings.title != empty -%}
        <header class="flex gap-3 px-3 text-gray-900">
          <div class="flex size-8 shrink-0 items-center justify-end bg-white text-gray-800">
            <svg viewBox="0 0 29.1 29.1" class="size-full" aria-hidden="true">
              <circle fill="currentColor" cx="11.8" cy="9.9" r="2.2"/>
              <circle fill="currentColor" cx="11.8" cy="19.2" r="2.2"/>
              <circle fill="currentColor" cx="20.1" cy="14.4" r="2.2"/>
            </svg>
          </div>
          <h1 class="text-base font-semibold text-balance">
            {{- section.settings.title -}}
          </h1>
        </header>
      {%- endif -%}

      {% if shop.password_message != empty %}
        <div class="px-3 text-sm">{{ shop.password_message }}</div>
      {% endif %}

      {%- if section.settings.text != empty %}
        <div class="px-3 text-sm text-gray-900">
          {{- section.settings.text -}}
        </div>
      {%- endif %}

      <footer class="border-t border-gray-800/10 px-6 pt-5 text-sm">
        {% form 'customer', class: 'space-y-2.5' %}
          {% if form.errors %}
            <div>{{- form.errors | default_errors -}}</div>
          {% endif %}

          <label for="email-input" class="sr-only">
            {{- 'password.password' | t -}}
          </label>

          <div class="relative">
            <input
              type="email"
              placeholder="{{ 'password.placeholder' | t }}"
              class="w-full pr-8 text-sm leading-snug placeholder:text-gray-800 lg:pr-10"
              name="contact[email]"
              id="email-input"
            >

            <button
              type="submit"
              class="absolute inset-y-0 right-0 flex size-5 items-center justify-center text-gray-500"
              aria-label="{{ 'password.enter' | t }}"
            >
              {%- render 'use.html', icon: 'arrow-right', classes: '' -%}
            </button>
          </div>
        {% endform %}
      </footer>
    </div>
  </div>

  <footer class="relative z-20">{%- render 'socials.html' -%}</footer>
  {{-
    section.settings.background_image
    | image_url: width: 2880
    | image_tag: class: 'absolute inset-0 z-0 size-full object-cover object-center'
  -}}
</main>

{% schema %}
{
  "name": "t:password.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:password.settings.background_image.label",
      "info": "t:password.settings.background_image.info"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:password.settings.title.label",
      "default": "t:password.settings.title.default",
      "info": "t:password.settings.title.info"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:password.settings.text.label",
      "default": "t:password.settings.text.default",
      "info": "t:password.settings.text.info"
    },
    {
      "type": "header",
      "content": "t:sections.shared.settings.padding.header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.shared.settings.padding.top.label",
      "info": "t:sections.shared.settings.padding.top.info",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.shared.settings.padding.bottom.label",
      "info": "t:sections.shared.settings.padding.bottom.info",
      "default": 60
    }
  ]
}
{% endschema %}

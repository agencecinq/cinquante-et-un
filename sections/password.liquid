{% comment %}
  Password landing page when storefront password protection is enabled.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | divided_by: 16.00 }}rem;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | divided_by: 16.00 }}rem;
  }

  @media (width >= 64rem) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 16.00 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 16.00 }}rem;
    }
  }
{% endstyle %}

<main
  class="section-{{ section.id }}-padding relative flex min-h-screen flex-col items-center gap-5 bg-gray-200 after:absolute after:inset-0 after:z-10 after:size-full after:bg-white/5 after:opacity-90 lg:gap-8"
>
  <header class="relative z-20 pt-8">
    <a
      href="{{ routes.root_url }}"
      class="text-sm font-semibold tracking-wide text-white uppercase"
      aria-label="{{ shop.name }}"
    >
      {{- shop.name -}}
    </a>
  </header>

  <div class="relative z-20 my-auto w-full max-w-sm px-2.5 lg:px-5">
    <div class="space-y-6 bg-white/90 py-6 backdrop-blur-sm">
      {%- if section.settings.title != blank -%}
        <header class="space-y-2 px-6">
          <h1 class="text-base font-semibold text-balance text-gray-900">
            {{- section.settings.title -}}
          </h1>
        </header>
      {%- endif -%}

      {%- if shop.password_message != blank -%}
        <div class="px-6 text-sm text-gray-700">{{ shop.password_message }}</div>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="wysiwyg px-6 text-sm text-gray-900">
          {{- section.settings.text -}}
        </div>
      {%- endif -%}

      <div class="space-y-6 border-t border-gray-800/10 px-6 pt-5">
        {%- form 'storefront_password', class: 'space-y-3' -%}
          <p class="text-xs font-medium tracking-wide text-gray-500 uppercase">
            {{- 'password.login_heading' | t -}}
          </p>

          {%- if form.errors -%}
            <div class="text-sm text-red-700" role="alert">
              {{- 'password.login_error' | t -}}
            </div>
          {%- endif -%}

          <label for="Password-{{ section.id }}" class="sr-only">
            {{- 'password.password' | t -}}
          </label>

          <div class="relative">
            <input
              type="password"
              name="password"
              id="Password-{{ section.id }}"
              autocomplete="current-password"
              placeholder="{{ 'password.password_placeholder' | t }}"
              class="w-full border border-gray-200 bg-white px-3 py-3 pr-12 text-sm leading-snug placeholder:text-gray-500"
              {% if form.errors %}
                aria-invalid="true"
              {% endif %}
            >

            <button
              type="submit"
              class="absolute inset-y-0 right-0 flex items-center justify-center px-3 text-gray-700"
              aria-label="{{ 'password.enter' | t }}"
            >
              {%- render 'use.html', icon: 'arrow-right', classes: 'size-4' -%}
            </button>
          </div>

          <p class="text-xs text-gray-500">
            {{- 'password.admin_link_html' | t -}}
          </p>
        {%- endform -%}

        {%- form 'customer', class: 'space-y-3 border-t border-gray-800/10 pt-5' -%}
          <input type="hidden" name="contact[tags]" value="prospect, password page">

          <p class="text-xs font-medium tracking-wide text-gray-500 uppercase">
            {{- 'password.email' | t -}}
          </p>

          {%- if form.posted_successfully? -%}
            <div class="text-sm text-gray-900" tabindex="-1" autofocus>
              {{- 'password.email_success' | t -}}
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <div class="text-sm text-red-700" role="alert">
                {{- form.errors | default_errors -}}
              </div>
            {%- endif -%}

            <label for="PasswordEmail-{{ section.id }}" class="sr-only">
              {{- 'password.email_label' | t -}}
            </label>

            <div class="relative">
              <input
                type="email"
                name="contact[email]"
                id="PasswordEmail-{{ section.id }}"
                autocomplete="email"
                placeholder="{{ 'password.placeholder' | t }}"
                class="w-full border border-gray-200 bg-white px-3 py-3 pr-12 text-sm leading-snug placeholder:text-gray-500"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="PasswordEmailError-{{ section.id }}"
                {% endif %}
              >

              <button
                type="submit"
                class="absolute inset-y-0 right-0 flex items-center justify-center px-3 text-gray-700"
                aria-label="{{ 'password.email_submit' | t }}"
              >
                {%- render 'use.html', icon: 'arrow-right', classes: 'size-4' -%}
              </button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>

  <footer class="relative z-20 pb-8 text-white [&_a]:border-white [&_a]:text-white [&_a:hover]:bg-white [&_a:hover]:text-black">
    {%- render 'socials.html' -%}
  </footer>

  {%- if section.settings.background_image != blank -%}
    {%- assign background_alt = section.settings.background_image.alt | default: shop.name -%}
    {{-
      section.settings.background_image
      | image_url: width: 2880
      | image_tag:
        class: 'absolute inset-0 z-0 size-full object-cover object-center',
        widths: '750, 1100, 1500, 1780, 2000, 2880',
        sizes: '100vw',
        alt: background_alt
    -}}
  {%- endif -%}
</main>

{% schema %}
{
  "name": "t:password.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:password.settings.background_image.label",
      "info": "t:password.settings.background_image.info"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:password.settings.title.label",
      "default": "This shop is private",
      "info": "t:password.settings.title.info"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:password.settings.text.label",
      "default": "<p>Enter the password to access the store, or leave your email to be notified when we open.</p>",
      "info": "t:password.settings.text.info"
    },
    {
      "type": "header",
      "content": "t:sections.shared.settings.padding.header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.shared.settings.padding.top.label",
      "info": "t:sections.shared.settings.padding.top.info",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.shared.settings.padding.bottom.label",
      "info": "t:sections.shared.settings.padding.bottom.info",
      "default": 60
    }
  ]
}
{% endschema %}
